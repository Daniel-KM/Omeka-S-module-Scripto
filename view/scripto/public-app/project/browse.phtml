<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SiteRepresentation $site NO // FIXME $site for scripto layout.
 */

// Il n'y a pas de site, donc pas de themeSetting, etc., donc on force le site.
if (empty($site)) {
    require_once dirname(__DIR__, 3) . '/helper/theme-functions.php';
    $site = prepareSite($this);
}

$this->scripto()->postTitle($this->translate('Projects'));
?>
<div class="resource-content">
    <div class="project resource-list">
        <?php if ($projects): ?>
        <?php foreach ($projects as $project): ?>
        <div class="resource-row">
            <?php echo $project->linkRaw($this->thumbnail($project, 'square', [
                'title' => $this->scripto()->translate($project->mediaType(), 'Primary media'),
                'alt' => $this->scripto()->translate($project->mediaType(), 'Primary media'),
            ])); ?>
            <div class="resource-meta">
                <h4><?php echo $project->link($project->title()); ?></h4>
                <div class="description"><?php echo $this->escapeHtml($project->description()); ?></div>
            </div>
        </div>
        <?php endforeach; ?>
        <?php else: ?>
        <div class="no-resources">
            <p><?php echo $this->translate('No Scripto projects found'); ?></p>
        </div>
        <?php endif; ?>
    </div>
</div>
